# Copy to .env and fill in. .env is gitignored — never commit real values.

# Execution mode: mock (offline, default) or bedrock (real AWS)
QM_MODE=mock

# --- Required when QM_MODE=bedrock ---
QM_AWS_ACCOUNT_ID=
QM_AWS_REGION=us-east-1

# Bedrock model id. VERIFY the current Claude model in your account before prod.
QM_BEDROCK_MODEL=anthropic.claude-sonnet-4-6
QM_BEDROCK_MAX_TOKENS=4096

# --- Agent behavior ---
QM_MAX_RETRIES=3

# --- Triage thresholds (what the core engine claims it can handle) ---
QM_MAX_VISUALS=8
QM_MAX_DATASOURCES=2
QM_MAX_COLUMNS_PER_VIZ=12
QM_FALLBACK_SCORE=5

# --- Logging ---
QM_LOG_LEVEL=INFO
QM_LOG_JSON=false
